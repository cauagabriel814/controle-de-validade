# Copie para .env e preencha os campos marcados com <...>.
#   cp .env.example .env
# Gerar segredos aleatórios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ---------------------------------------------------------------------------
# Docker Compose (postgres, minio, api, front)
# ---------------------------------------------------------------------------
POSTGRES_DB=validade
POSTGRES_USER=validade
POSTGRES_PASSWORD=<senha-forte>

MINIO_ROOT_USER=validade
MINIO_ROOT_PASSWORD=<senha-forte-com-8+-caracteres>
S3_BUCKET=fotos

# Portas no seu computador. Se alguma já estiver em uso por outro projeto, troque aqui.
FRONT_PORT=8080
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025
# Endereço público do sistema: usado nos links dos e-mails de convite e de senha
APP_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Assina os tokens de sessão. Mínimo 32 caracteres, aleatório. Trocar derruba todas as sessões.
JWT_SECRET=<segredo-aleatorio-de-32+-caracteres>
SESSION_HOURS=12
TZ_LOJA=America/Sao_Paulo

# Administrador criado no primeiro start (só se ainda não houver usuários)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@mercadinho.local
ADMIN_PASSWORD=<senha-inicial-do-admin>

# ---------------------------------------------------------------------------
# E-mail (convite de usuários novos e "esqueci minha senha")
# ---------------------------------------------------------------------------
# No Docker, sem configurar nada, vai para o Mailpit (http://localhost:8025).
# Para enviar de verdade (ex.: Gmail com senha de app, Brevo, SendGrid), descomente:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=<senha-de-app>
MAIL_FROM=Controle de Validade <nao-responda@mercadinho.local>

# ---------------------------------------------------------------------------
# Só para rodar a API fora do Docker (npm run dev), com a infra no Docker:
#   docker compose up -d postgres minio mailpit
# No Docker estes valores são substituídos automaticamente pelo compose.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://validade:<senha-forte>@localhost:5432/validade
S3_ENDPOINT=localhost
S3_PORT=9000
S3_ACCESS_KEY=validade
S3_SECRET_KEY=<mesma-senha-do-MINIO_ROOT_PASSWORD>
SERVE_STATIC=true
